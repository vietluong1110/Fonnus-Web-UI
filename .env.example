# Copy to `.env.local` and edit. Nothing here is a secret: Vite inlines every
# VITE_* value into the built JavaScript, so it is public the moment you deploy.
# Real secrets belong on the backend, never in this file.

# ---------------------------------------------------------------- API mode

# Which implementation of the API the app talks to.
#
#   mock — everything is faked in the browser. No backend needed. This is the
#          default, and it is what keeps the demo login working:
#          phone 0914378064, code 111002.
#   live — real HTTP requests to VITE_API_BASE_URL.
#
VITE_API_MODE=mock

# Run *selected* groups against the real backend while the rest stay mocked.
# The backend ships endpoints one at a time, so this is how you test the first
# real one without waiting for all of them.
#
# Comma-separated, any of the groups in src/api/contracts.ts:
# Groups: auth, tenant, assistant, receptionist, voice, insights, calls, leads
# Example: VITE_API_LIVE_GROUPS=tenant
#
VITE_API_LIVE_GROUPS=

# ---------------------------------------------------------------- Where

# Where the app sends its requests.
#
#   dev  — leave this as a path (/api/v1) and let the dev proxy below forward
#          it. The browser then only ever talks to localhost, so there is no
#          CORS and no cookie trouble at all.
#   prod — a full absolute URL, e.g. https://api.fonnus.vn/v1
#
# Note: the build ships with `base: './'` so it can be dropped at any path, but
# an absolute path like /api/v1 is still resolved from the site root. In
# production always set a full URL.
#
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api. Read by vite.config.ts, not by the app.
VITE_DEV_API_TARGET=http://localhost:3000

# ---------------------------------------------------------------- Mock knobs

# How long the mock pretends the network takes, in milliseconds.
# Set to 0 for a snappy live demo; leave at 450 to keep the loading states honest.
VITE_MOCK_LATENCY_MS=450

# Fraction of mock requests that fail, 0..1. Set to 1 to walk every error state
# in the UI without a backend running. This is the only way to see the save-
# failure and retry paths, so use it before shipping anything that touches them.
VITE_MOCK_FAILURE_RATE=0

# How busy the mock clinic is this billing cycle: normal | near | over. `near` runs
# out of minutes before the renewal and `over` is past the limit — the two warning
# states of the minutes meter on Cài đặt.
VITE_MOCK_USAGE=normal
